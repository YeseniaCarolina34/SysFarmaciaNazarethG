@model SysFarmaciaNazarethG.Models.DetalleFactura

@{
    ViewData["Title"] = "Detalles del DetalleFactura";
}

<h1 class="text-center" style="color: #1976D2;">Detalles del DetalleFactura</h1>

<div class="container" style="border: 1px solid #BBDEFB; background-color: #E3F2FD; border-radius: 10px; padding: 20px;">
    <h4 class="text-center" style="color: #0D47A1;">Información del Detalle de la Factura</h4>
    <hr />
    <div class="row">
        <!-- Primera columna -->
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Cantidad</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Cantidad)</dd>

                <dt class="col-sm-4">Descripción</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Descripcion)</dd>

                <dt class="col-sm-4">Precio Unitario</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.PrecioUnitario)</dd>

                <dt class="col-sm-4">Total</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Total)</dd>
            </dl>
        </div>

        <!-- Segunda columna -->
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Factura</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.IdFacturaNavigation.IdFactura)</dd>

                <dt class="col-sm-4">Producto</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.IdProductoNavigation.Id)</dd>
            </dl>
        </div>
    </div>

    <div class="text-center mt-4">
        <a asp-action="Edit" asp-route-id="@Model?.IdDetalleFactura" class="btn btn-primary" style="width: 150px;">Editar</a>
        <a asp-action="Index" class="btn btn-secondary" style="width: 150px;">Regresar</a>
    </div>
</div>
