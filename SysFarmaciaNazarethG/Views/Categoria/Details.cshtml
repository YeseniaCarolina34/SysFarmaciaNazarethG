@model SysFarmaciaNazarethG.Models.Categoria

@{
    ViewData["Title"] = "Details";
}

<h1 class="text-center" style="color: #1976D2;">Detalles de la Categoría</h1>

<div class="container" style="border: 1px solid #BBDEFB; background-color: #E3F2FD; border-radius: 10px; padding: 20px;">
    <h4 class="text-center" style="color: #0D47A1;">Información de la Categoría</h4>
    <hr />
    <div class="row">
        <!-- Primera columna -->
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Nombre</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Nombre)</dd>

                <dt class="col-sm-4">Descripción</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Descripción)</dd>
            </dl>
        </div>

        <!-- Segunda columna -->
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Inventario</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.IdInventarioNavigation.IdInventario)</dd>
            </dl>
        </div>
    </div>
    <div class="text-center mt-4">
        <a asp-action="Edit" asp-route-id="@Model?.IdCategoria" class="btn btn-primary" style="width: 150px;">Editar</a>
        <a asp-action="Index" class="btn btn-secondary" style="width: 150px;">Regresar</a>
    </div>
</div>
