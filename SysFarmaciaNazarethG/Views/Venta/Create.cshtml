@model SysFarmaciaNazarethG.Models.Venta

@{
    ViewData["Title"] = "Create";
}

<div style="background-color: #E8F5E9; padding: 20px; border-radius: 8px;">
    <h1 class="text-center" style="color: #2E7D32;">Crear Venta</h1>
    <h4 class="text-center" style="color: #1B5E20;">Información de la Venta</h4>
    <hr />
    <div class="container" style="border: 1px solid #A5D6A7; padding: 20px; border-radius: 8px; background-color: #E8F5E9;">
        <form class="row" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Primera columna -->
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="IdProducto" class="control-label font-weight-bold" style="color: black;"></label>
                    <select asp-for="IdProducto" id="idProductoSelect" class="form-control" style="border: 1px solid #81C784;" asp-items="ViewBag.IdProducto">
                        <option value="">-- Seleccione un producto --</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="control-label font-weight-bold" style="color: black;">Descripción del Producto</label>
                    <input id="descripcionProducto" class="form-control" style="border: 1px solid #81C784;" readonly />
                </div>

                <div class="form-group">
                    <label asp-for="PrecioUnitario" class="control-label font-weight-bold" style="color: black;"></label>
                    <input asp-for="PrecioUnitario" class="form-control" style="border: 1px solid #81C784;" />
                    <span asp-validation-for="PrecioUnitario" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="PrecioTotal" class="control-label font-weight-bold" style="color: black;"></label>
                    <input asp-for="PrecioTotal" class="form-control" style="border: 1px solid #81C784;" />
                    <span asp-validation-for="PrecioTotal" class="text-danger"></span>
                </div>
            </div>

            <!-- Segunda columna -->
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="EnviosDeSucursal" class="control-label font-weight-bold" style="color: black;"></label>
                    <input asp-for="EnviosDeSucursal" class="form-control" style="border: 1px solid #81C784;" />
                    <span asp-validation-for="EnviosDeSucursal" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Cantidad" class="control-label font-weight-bold" style="color: black;"></label>
                    <input asp-for="Cantidad" class="form-control" style="border: 1px solid #81C784;" />
                    <span asp-validation-for="Cantidad" class="text-danger"></span>
                </div>
            </div>

            <!-- Botones centrados al final -->
            <div class="form-group mt-4 text-center col-md-12">
                <input type="submit" value="Crear" class="btn" style="background-color: #2E7D32; color: white; border: none; width: 120px;" />
                <a asp-action="Index" class="btn" style="background-color: #66BB6A; color: white; border: none; width: 120px;">Cancelar</a>
            </div>
        </form>
    </div>
</div>

<!-- Script para obtener la descripción del producto -->
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.getElementById("idProductoSelect").addEventListener("change", function () {
            var idProducto = this.value;

            if (idProducto) {
                fetch(`/Venta/GetDescripcionProducto?idProducto=${idProducto}`)
                    .then(response => {
                        if (!response.ok) {
                            throw new Error("Error en la respuesta del servidor");
                        }
                        return response.json();
                    })
                    .then(data => {
                        document.getElementById("descripcionProducto").value = data.descripcion || "Descripción no disponible";
                    })
                    .catch(error => {
                        console.error("Error al obtener la descripción:", error);
                        document.getElementById("descripcionProducto").value = "Error al cargar la descripción";
                    });
            } else {
                document.getElementById("descripcionProducto").value = "";
            }
        });

    </script>
}
