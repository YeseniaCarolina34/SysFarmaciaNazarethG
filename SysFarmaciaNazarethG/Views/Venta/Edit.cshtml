@model SysFarmaciaNazarethG.Models.Venta

@{
    ViewData["Title"] = "Edit";
}

<h1 class="text-center" style="color:#2E7D32;">Editar Venta</h1>

<div class="container" style="border: 1px solid #A5D6A7; padding: 20px; border-radius: 8px; background-color: #E8F5E9;">
    <h4 class="text-center" style="color: #2E7D32;">Formulario de Edición</h4>
    <hr />
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="IdVenta" />

        <div class="row">
            <!-- Primera columna -->
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Cantidad" class="control-label"></label>
                    <input asp-for="Cantidad" class="form-control" />
                    <span asp-validation-for="Cantidad" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="PrecioUnitario" class="control-label"></label>
                    <input asp-for="PrecioUnitario" class="form-control" />
                    <span asp-validation-for="PrecioUnitario" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="PrecioTotal" class="control-label"></label>
                    <input asp-for="PrecioTotal" class="form-control" />
                    <span asp-validation-for="PrecioTotal" class="text-danger"></span>
                </div>
            </div>

            <!-- Segunda columna -->
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="EnviosDeSucursal" class="control-label"></label>
                    <input asp-for="EnviosDeSucursal" class="form-control" />
                    <span asp-validation-for="EnviosDeSucursal" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="IdProducto" class="control-label"></label>
                    <select asp-for="IdProducto" class="form-control" asp-items="ViewBag.IdProducto"></select>
                    <span asp-validation-for="IdProducto" class="text-danger"></span>
                </div>
                <div class="form-group text-center mt-4">
                    <input type="submit" value="Guardar" class="btn btn-primary" style="width: 150px;" />
                    <a asp-action="Index" class="btn btn-secondary" style="width: 150px;">Regresar</a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
