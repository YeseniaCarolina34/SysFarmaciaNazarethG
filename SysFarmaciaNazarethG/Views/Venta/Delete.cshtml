@model SysFarmaciaNazarethG.Models.Venta

@{
    ViewData["Title"] = "Delete";
}

<h1 class="text-center" style="color: #2E7D32;">Eliminar Venta</h1>
<h3 class="text-center" style="color: #D32F2F;">¿Estás seguro de que quieres eliminar esta venta?</h3>

<div class="container" style="border: 1px solid #FFCDD2; background-color: #FFEBEE; border-radius: 10px; padding: 20px;">
    <h4 class="text-center" style="color: #2E7D32;">Información de la Venta</h4>
    <hr />
    <div class="row">
        <!-- Primera columna -->
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Cantidad</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Cantidad)</dd>

                <dt class="col-sm-4">Precio Unitario</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.PrecioUnitario)</dd>

                <dt class="col-sm-4">Precio Total</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.PrecioTotal)</dd>
            </dl>
        </div>

        <!-- Segunda columna -->
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Envíos de Sucursal</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.EnviosDeSucursal)</dd>

                <dt class="col-sm-4">Producto ID</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.IdProductoNavigation.Id)</dd>
            </dl>
        </div>
    </div>

    <form asp-action="Delete" class="text-center mt-4">
        <input type="hidden" asp-for="IdVenta" />
        <input type="submit" value="Eliminar" class="btn btn-danger" style="width: 150px;" /> |
        <a asp-action="Index" class="btn btn-secondary" style="width: 150px;">Regresar</a>
    </form>
</div>
