@model IEnumerable<SysFarmaciaNazarethG.Models.Venta>

@{
    ViewData["Title"] = "Index";
}
<head>
    <link rel="stylesheet" href="~/css/crud.css" />
</head>
<h1>VENTAS</h1>



<p>
    <a href="/Venta/Create" class="btn" style="background-color:#4CAF50;color: white;">Crear nueva Venta</a>
</p>


<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Cantidad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PrecioUnitario)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PrecioTotal)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EnviosDeSucursal)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Cantidad)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PrecioUnitario)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PrecioTotal)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EnviosDeSucursal)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdVenta">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.IdVenta">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@item.IdVenta">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
