@model SysFarmaciaNazarethG.Models.Rol

@{
    ViewData["Title"] = "Crear Rol";
}

<head>
    <link rel="stylesheet" href="~/css/crud.css" />
</head>

<h1 class="text-center" style="color:#2E7D32;">Crear Rol</h1>

<div class="container" style="border: 1px solid #A5D6A7; padding: 20px; border-radius: 8px; background-color: #E8F5E9;">
    <h4 class="text-center" style="color: #2E7D32;">Formulario de Creación de Rol</h4>
    <hr />
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <!-- Primera columna -->
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Nombre" class="control-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="text-center mt-4">
            <input type="submit" value="Crear" class="btn btn-primary" style="width: 150px;" />
        </div>
    </form>

    <div class="text-center mt-4">
        <a asp-action="Index" class="btn btn-secondary" style="width: 150px;">Regresar</a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
