@model SysFarmaciaNazarethG.Models.Rol

@{
    ViewData["Title"] = "Eliminar Rol";
}

<h1 class="text-center" style="color:#2E7D32;">Eliminar Rol</h1>

<div class="container" style="border: 1px solid #A5D6A7; padding: 20px; border-radius: 8px; background-color: #E8F5E9;">
    <h4 class="text-center" style="color: #2E7D32;">Estás seguro de que quieres eliminar este rol?</h4>
    <hr />
    <div>
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Nombre)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Nombre)
            </dd>
        </dl>
    </div>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="form-group text-center mt-4">
            <input type="submit" value="Eliminar" class="btn btn-danger" style="width: 150px;" />
        </div>
    </form>

    <div class="text-center mt-4">
        <a asp-action="Index" class="btn btn-secondary" style="width: 150px;">Regresar</a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
