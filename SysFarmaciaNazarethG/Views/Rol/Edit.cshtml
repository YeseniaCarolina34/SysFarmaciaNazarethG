@model SysFarmaciaNazarethG.Models.Rol

@{
    ViewData["Title"] = "Editar Rol";
}

<h1 class="text-center" style="color:#2E7D32;">Editar Rol</h1>

<div class="container" style="border: 1px solid #A5D6A7; padding: 20px; border-radius: 8px; background-color: #E8F5E9;">
    <h4 class="text-center" style="color: #2E7D32;">Modificar Información del Rol</h4>
    <hr />
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label asp-for="Nombre" class="control-label" style="color: #2E7D32;"></label>
            <input asp-for="Nombre" class="form-control" style="width: 80%; margin: 0 auto;" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="form-group text-center mt-4">
            <input type="submit" value="Guardar" class="btn btn-success" style="width: 150px;" />
        </div>
    </form>
</div>

<div class="text-center mt-4">
    <a asp-action="Index" class="btn btn-secondary" style="width: 150px;">Regresar</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
