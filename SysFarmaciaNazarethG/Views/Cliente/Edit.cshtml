@model SysFarmaciaNazarethG.Models.Cliente

@{
    ViewData["Title"] = "Editar Cliente";
}

<h1 class="text-center" style="color:#2E7D32;">Editar Cliente</h1>

<div class="container" style="border: 1px solid #A5D6A7; padding: 20px; border-radius: 8px; background-color: #E8F5E9;">
    <h4 class="text-center" style="color: #2E7D32;">Formulario de Edición de Cliente</h4>
    <hr />
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="IdCliente" />

        <div class="row">
            <!-- Primera columna -->
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Nombre" class="control-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Direccion" class="control-label"></label>
                    <input asp-for="Direccion" class="form-control" />
                    <span asp-validation-for="Direccion" class="text-danger"></span>
                </div>
            </div>

            <!-- Segunda columna -->
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="VentaACuentaDe" class="control-label"></label>
                    <input asp-for="VentaACuentaDe" class="form-control" />
                    <span asp-validation-for="VentaACuentaDe" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="text-center mt-4">
            <input type="submit" value="Guardar" class="btn btn-primary" style="width: 150px;" />
            <a asp-action="Index" class="btn btn-secondary" style="width: 150px;">Regresar</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
