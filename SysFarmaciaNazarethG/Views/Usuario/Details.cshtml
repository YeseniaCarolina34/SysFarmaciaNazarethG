@model SysFarmaciaNazarethG.Models.Usuario

@{
    ViewData["Title"] = "Detalles del Usuario";
}

<h1 class="text-center" style="color: #1E88E5;">Detalles del Usuario</h1>

<div class="container" style="background-color: #F5F5F5; border-radius: 10px; padding: 20px;">
    <h4 class="text-center" style="color: #0288D1;">Información del Usuario</h4>
    <hr />
    <div class="row">
        <!-- Columna 1 -->
        <div class="col-sm-6">
            <dl class="row">
                <dt class="col-sm-4 font-weight-bold">
                    @Html.DisplayNameFor(model => model.Nombre)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Nombre)
                </dd>

                <dt class="col-sm-4 font-weight-bold">
                    @Html.DisplayNameFor(model => model.Apellido)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Apellido)
                </dd>

                <dt class="col-sm-4 font-weight-bold">
                    @Html.DisplayNameFor(model => model.Email)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Email)
                </dd>
            </dl>
        </div>

        <!-- Columna 2 -->
        <div class="col-sm-6">
            <dl class="row">
                <dt class="col-sm-4 font-weight-bold">
                    @Html.DisplayNameFor(model => model.Password)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Password)
                </dd>

                <dt class="col-sm-4 font-weight-bold">
                    @Html.DisplayNameFor(model => model.Estatus)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Estatus)
                </dd>

                <dt class="col-sm-4 font-weight-bold">
                    @Html.DisplayNameFor(model => model.FechaRegistro)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.FechaRegistro)
                </dd>

                <dt class="col-sm-4 font-weight-bold">
                    @Html.DisplayNameFor(model => model.IdRolNavigation)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.IdRolNavigation.Id)
                </dd>
            </dl>
        </div>
    </div>
</div>

<div class="text-center mt-4">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary" style="width: 150px;">Editar</a> |
    <a asp-action="Index" class="btn btn-secondary" style="width: 150px;">Regresar</a>
</div>
