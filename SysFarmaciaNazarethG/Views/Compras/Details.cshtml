@model SysFarmaciaNazarethG.Models.Compras

@{
    ViewData["Title"] = "Details";
}

<h1 class="text-center" style="color: #1976D2;">Detalles de la Compra</h1>

<div class="container" style="border: 1px solid #BBDEFB; background-color: #E3F2FD; border-radius: 10px; padding: 20px;">
    <h4 class="text-center" style="color: #0D47A1;">Información de la Compra</h4>
    <hr />
    <div class="row">
        <!-- Primera columna -->
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Código</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Codigo)</dd>

                <dt class="col-sm-4">Descripción</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Descripcion)</dd>

                <dt class="col-sm-4">Cantidad</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Cantidad)</dd>

                <dt class="col-sm-4">Bonificación</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Bonificacion)</dd>

                <dt class="col-sm-4">Precio Unitario</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.PrecioUnitario)</dd>
            </dl>
        </div>

        <!-- Segunda columna -->
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Laboratorio</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Laboratorio)</dd>

                <dt class="col-sm-4">Descuento</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Descuento)</dd>

                <dt class="col-sm-4">Ventas No Sujetas</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.VentasNoSujetas)</dd>

                <dt class="col-sm-4">Ventas Extensas</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.VentasExtensas)</dd>

                <dt class="col-sm-4">Ventas Afectas</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.VentasAfectas)</dd>

                <dt class="col-sm-4">Nombre</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Nombre)</dd>

            </dl>

        </div>
    </div>

    <div class="text-center mt-4">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary" style="width: 150px;">Editar</a>
        <a asp-action="Index" class="btn btn-secondary" style="width: 150px;">Regresar</a>
    </div>
</div>
