@model SysFarmaciaNazarethG.Models.Proveedor

@{
    ViewData["Title"] = "Crear Proveedor";
}

<h1 class="text-center" style="color:#2E7D32;">Crear Proveedor</h1>

<div class="container" style="border: 1px solid #A5D6A7; padding: 20px; border-radius: 8px; background-color: #E8F5E9;">
    <h4 class="text-center" style="color: #2E7D32;">Registrar Información del Proveedor</h4>
    <hr />
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row">
            <!-- Primera columna -->
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Nombre" class="control-label" style="color: #2E7D32;"></label>
                    <input asp-for="Nombre" class="form-control" style="width: 100%;" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Dui" class="control-label" style="color: #2E7D32;"></label>
                    <input asp-for="Dui" class="form-control" style="width: 100%;" />
                    <span asp-validation-for="Dui" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="PersonaDeContacto" class="control-label" style="color: #2E7D32;"></label>
                    <input asp-for="PersonaDeContacto" class="form-control" style="width: 100%;" />
                    <span asp-validation-for="PersonaDeContacto" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Teléfono" class="control-label" style="color: #2E7D32;"></label>
                    <input asp-for="Teléfono" class="form-control" style="width: 100%;" />
                    <span asp-validation-for="Teléfono" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="CorreoElectrónico" class="control-label" style="color: #2E7D32;"></label>
                    <input asp-for="CorreoElectrónico" class="form-control" style="width: 100%;" />
                    <span asp-validation-for="CorreoElectrónico" class="text-danger"></span>
                </div>
            </div>

            <!-- Segunda columna -->
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Dirección" class="control-label" style="color: #2E7D32;"></label>
                    <input asp-for="Dirección" class="form-control" style="width: 100%;" />
                    <span asp-validation-for="Dirección" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="País" class="control-label" style="color: #2E7D32;"></label>
                    <input asp-for="País" class="form-control" style="width: 100%;" />
                    <span asp-validation-for="País" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="MétodoDePago" class="control-label" style="color: #2E7D32;"></label>
                    <input asp-for="MétodoDePago" class="form-control" style="width: 100%;" />
                    <span asp-validation-for="MétodoDePago" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="BancoYnumeroDeCuenta" class="control-label" style="color: #2E7D32;"></label>
                    <input asp-for="BancoYnumeroDeCuenta" class="form-control" style="width: 100%;" />
                    <span asp-validation-for="BancoYnumeroDeCuenta" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="MonedaDeTransacción" class="control-label" style="color: #2E7D32;"></label>
                    <input asp-for="MonedaDeTransacción" class="form-control" style="width: 100%;" />
                    <span asp-validation-for="MonedaDeTransacción" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="IdUsuario" class="control-label" style="color: #2E7D32;"></label>
                    <select asp-for="IdUsuario" class="form-control" asp-items="ViewBag.IdUsuario" style="width: 100%;"></select>
                </div>
            </div>
            <!-- Botones centrados al final -->
            <div class="form-group mt-4 text-center col-md-12">
                <input type="submit" value="Crear" class="btn" style="background-color: #2E7D32; color: white; border: none; width: 120px;" />
                <a asp-action="Index" class="btn" style="background-color: #66BB6A; color: white; border: none; width: 120px;">Cancelar</a>
            </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
