@model SysFarmaciaNazarethG.Models.Proveedor

@{
    ViewData["Title"] = "Editar";
}

<h1 class="text-center" style="color:#2E7D32;">Editar Proveedor</h1>

<div class="container" style="border: 1px solid #A5D6A7; padding: 20px; border-radius: 8px; background-color: #E8F5E9;">
    <h4 class="text-center" style="color: #2E7D32;">Formulario de Edición</h4>
    <hr />
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="IdProveedor" />

        <div class="row">
            <!-- Primera columna -->
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Nombre" class="control-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Dui" class="control-label"></label>
                    <input asp-for="Dui" class="form-control" />
                    <span asp-validation-for="Dui" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="PersonaDeContacto" class="control-label"></label>
                    <input asp-for="PersonaDeContacto" class="form-control" />
                    <span asp-validation-for="PersonaDeContacto" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Teléfono" class="control-label"></label>
                    <input asp-for="Teléfono" class="form-control" />
                    <span asp-validation-for="Teléfono" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="CorreoElectrónico" class="control-label"></label>
                    <input asp-for="CorreoElectrónico" class="form-control" />
                    <span asp-validation-for="CorreoElectrónico" class="text-danger"></span>
                </div>
            </div>

            <!-- Segunda columna -->
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Dirección" class="control-label"></label>
                    <input asp-for="Dirección" class="form-control" />
                    <span asp-validation-for="Dirección" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="País" class="control-label"></label>
                    <input asp-for="País" class="form-control" />
                    <span asp-validation-for="País" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="MétodoDePago" class="control-label"></label>
                    <input asp-for="MétodoDePago" class="form-control" />
                    <span asp-validation-for="MétodoDePago" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="BancoYnumeroDeCuenta" class="control-label"></label>
                    <input asp-for="BancoYnumeroDeCuenta" class="form-control" />
                    <span asp-validation-for="BancoYnumeroDeCuenta" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="MonedaDeTransacción" class="control-label"></label>
                    <input asp-for="MonedaDeTransacción" class="form-control" />
                    <span asp-validation-for="MonedaDeTransacción" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="IdUsuario" class="control-label"></label>
                    <select asp-for="IdUsuario" class="form-control" asp-items="ViewBag.IdUsuario"></select>
                    <span asp-validation-for="IdUsuario" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="text-center mt-4">
            <input type="submit" value="Guardar" class="btn btn-primary" style="width: 150px;" />
            <a asp-action="Index" class="btn btn-secondary" style="width: 150px;">Regresar</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
