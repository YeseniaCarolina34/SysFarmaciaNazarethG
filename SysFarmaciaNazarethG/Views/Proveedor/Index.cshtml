@model IEnumerable<SysFarmaciaNazarethG.Models.Proveedor>

@{
    ViewData["Title"] = "Index";
}
<head>
    <link rel="stylesheet" href="~/css/crud.css" />
</head>
<h1>PROVEDORES</h1>


<p>
    <a href="/Proveedor/Create" class="btn" style="background-color:#4CAF50;color: white;">Crear Proveedor</a>
</p>


<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Dui)
            </th>


            <th>
                @Html.DisplayNameFor(model => model.Teléfono)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Dirección)
            </th>


            <th>
                @Html.DisplayNameFor(model => model.MétodoDePago)
            </th>


            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Dui)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Teléfono)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Dirección)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.MétodoDePago)
                </td>



                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdProveedor">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.IdProveedor">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@item.IdProveedor">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
