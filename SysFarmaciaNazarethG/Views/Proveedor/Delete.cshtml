@model SysFarmaciaNazarethG.Models.Proveedor

@{
    ViewData["Title"] = "Delete";
}

<h1 class="text-center" style="color: #2E7D32;">Eliminar Proveedor</h1>
<h3 class="text-center" style="color: #D32F2F;">¿Estás seguro de que quieres eliminar este proveedor?</h3>

<div class="container" style="border: 1px solid #FFCDD2; background-color: #FFEBEE; border-radius: 10px; padding: 20px;">
    <h4 class="text-center" style="color: #2E7D32;">Información del Proveedor</h4>
    <hr />
    <div class="row">
        <!-- Primera columna -->
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Nombre</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Nombre)</dd>

                <dt class="col-sm-4">DUI</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Dui)</dd>

                <dt class="col-sm-4">Persona de Contacto</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.PersonaDeContacto)</dd>

                <dt class="col-sm-4">Teléfono</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Teléfono)</dd>

                <dt class="col-sm-4">Correo Electrónico</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.CorreoElectrónico)</dd>
            </dl>
        </div>

        <!-- Segunda columna -->
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Dirección</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Dirección)</dd>

                <dt class="col-sm-4">País</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.País)</dd>

                <dt class="col-sm-4">Método de Pago</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.MétodoDePago)</dd>

                <dt class="col-sm-4">Banco y Número de Cuenta</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.BancoYnumeroDeCuenta)</dd>

                <dt class="col-sm-4">Moneda de Transacción</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.MonedaDeTransacción)</dd>
            </dl>
        </div>
    </div>

    <form asp-action="Delete" class="text-center mt-4">
        <input type="hidden" asp-for="IdProveedor" />
        <input type="submit" value="Eliminar" class="btn btn-danger" style="width: 150px;" /> |
        <a asp-action="Index" class="btn btn-secondary" style="width: 150px;">Regresar</a>
    </form>
</div>
