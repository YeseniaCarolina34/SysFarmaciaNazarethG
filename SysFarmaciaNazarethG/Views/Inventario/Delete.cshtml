@model SysFarmaciaNazarethG.Models.Inventario

@{
    ViewData["Title"] = "Delete";
}

<h1 class="text-center" style="color: #2E7D32;">Eliminar Inventario</h1>
<h3 class="text-center" style="color: #D32F2F;">¿Estás seguro de que quieres eliminar este inventario?</h3>

<div class="container" style="border: 1px solid #FFCDD2; background-color: #FFEBEE; border-radius: 10px; padding: 20px;">
    <h4 class="text-center" style="color: #2E7D32;">Información del Inventario</h4>
    <hr />
    <div class="row">
        <!-- Primera columna -->
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Cantidad</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Cantidad)</dd>

                <dt class="col-sm-4">Ubicación</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Ubicación)</dd>

                <dt class="col-sm-4">Fecha de Ingreso</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.FechaDeIngreso)</dd>

                <dt class="col-sm-4">Estado</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Estado)</dd>
            </dl>
        </div>

        <!-- Segunda columna -->
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Producto ID</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.IdProductoNavigation.Id)</dd>

                <dt class="col-sm-4">Producto Nombre</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.IdProductoNavigation.Nombre)</dd>

                <dt class="col-sm-4">Descripción</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.IdProductoNavigation.Descripción)</dd>
            </dl>
        </div>
    </div>

    <form asp-action="Delete" class="text-center mt-4">
        <input type="hidden" asp-for="IdInventario" />
        <input type="submit" value="Eliminar" class="btn btn-danger" style="width: 150px;" /> |
        <a asp-action="Index" class="btn btn-secondary" style="width: 150px;">Regresar</a>
    </form>
</div>
