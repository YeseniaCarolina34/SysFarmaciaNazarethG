@model SysFarmaciaNazarethG.Models.Inventario

@{
    ViewData["Title"] = "Create";
}

<div style="background-color: #E8F5E9; padding: 20px; border-radius: 8px;">
    <h1 class="text-center" style="color: #2E7D32;">Crear Inventario</h1>
    <h4 class="text-center" style="color: #1B5E20;">Información del Inventario</h4>
    <hr />
    <div class="container" style="border: 1px solid #A5D6A7; padding: 20px; border-radius: 8px; background-color: #E8F5E9;">
        <form class="row" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Primera columna -->
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="IdProducto" class="control-label font-weight-bold" style="color: black;"></label>
                    <select asp-for="IdProducto" class="form-control" style="border: 1px solid #81C784;" asp-items="ViewBag.IdProducto"></select>
                </div>
                <div class="form-group">
                    <label asp-for="Cantidad" class="control-label font-weight-bold" style="color: black;"></label>
                    <input asp-for="Cantidad" class="form-control" style="border: 1px solid #81C784;" />
                    <span asp-validation-for="Cantidad" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Ubicación" class="control-label font-weight-bold" style="color: black;"></label>
                    <input asp-for="Ubicación" class="form-control" style="border: 1px solid #81C784;" />
                    <span asp-validation-for="Ubicación" class="text-danger"></span>
                </div>
            </div>

            <!-- Segunda columna -->
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="FechaDeIngreso" class="control-label font-weight-bold" style="color: black;"></label>
                    <input asp-for="FechaDeIngreso" class="form-control" style="border: 1px solid #81C784;" />
                    <span asp-validation-for="FechaDeIngreso" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Estado" class="control-label font-weight-bold" style="color: black;"></label>
                    <input asp-for="Estado" class="form-control" style="border: 1px solid #81C784;" />
                    <span asp-validation-for="Estado" class="text-danger"></span>
                </div>
            </div>

            <!-- Botones centrados al final -->
            <div class="form-group mt-4 text-center col-md-12">
                <input type="submit" value="Crear" class="btn" style="background-color: #2E7D32; color: white; border: none; width: 120px;" />
                <a asp-action="Index" class="btn" style="background-color: #66BB6A; color: white; border: none; width: 120px;">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
