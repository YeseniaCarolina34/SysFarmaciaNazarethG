@model SysFarmaciaNazarethG.Models.Producto

@{
    ViewData["Title"] = "Edit";
}

<h1 class="text-center" style="color:#2E7D32;">Editar Producto</h1>

<div class="container" style="border: 1px solid #A5D6A7; padding: 20px; border-radius: 8px; background-color: #E8F5E9;">
    <h4 class="text-center" style="color: #2E7D32;">Formulario de Edición</h4>
    <hr />
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="Id" />

        <div class="row">
            <!-- Primera columna -->
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Nombre" class="control-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Descripción" class="control-label"></label>
                    <input asp-for="Descripción" class="form-control" />
                    <span asp-validation-for="Descripción" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="PrecioCosto" class="control-label"></label>
                    <input asp-for="PrecioCosto" class="form-control" />
                    <span asp-validation-for="PrecioCosto" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="PrecioVenta" class="control-label"></label>
                    <input asp-for="PrecioVenta" class="form-control" />
                    <span asp-validation-for="PrecioVenta" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="CódigoDeBarras" class="control-label"></label>
                    <input asp-for="CódigoDeBarras" class="form-control" />
                    <span asp-validation-for="CódigoDeBarras" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="CantidadEnInventario" class="control-label"></label>
                    <input asp-for="CantidadEnInventario" class="form-control" />
                    <span asp-validation-for="CantidadEnInventario" class="text-danger"></span>
                </div>
            </div>

            <!-- Segunda columna -->
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="FechaDeIngreso" class="control-label"></label>
                    <input asp-for="FechaDeIngreso" class="form-control" />
                    <span asp-validation-for="FechaDeIngreso" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="FechaDeCaducidad" class="control-label"></label>
                    <input asp-for="FechaDeCaducidad" class="form-control" />
                    <span asp-validation-for="FechaDeCaducidad" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Estado" class="control-label"></label>
                    <input asp-for="Estado" class="form-control" />
                    <span asp-validation-for="Estado" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Laboratorio" class="control-label"></label>
                    <input asp-for="Laboratorio" class="form-control" />
                    <span asp-validation-for="Laboratorio" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="IdProveedor" class="control-label"></label>
                    <select asp-for="IdProveedor" class="form-control" asp-items="ViewBag.IdProveedor"></select>
                    <span asp-validation-for="IdProveedor" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="text-center mt-4">
            <input type="submit" value="Guardar" class="btn btn-primary" style="width: 150px;" />
            <a asp-action="Index" class="btn btn-secondary" style="width: 150px;">Regresar</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
