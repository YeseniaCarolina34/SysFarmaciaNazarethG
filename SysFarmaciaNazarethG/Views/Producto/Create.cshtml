@model SysFarmaciaNazarethG.Models.Producto

@{
    ViewData["Title"] = "Create";
}

<div style="background-color: #E8F5E9; padding: 20px; border-radius: 8px;">
    <h1 class="text-center" style="color: #2E7D32;">Crear Producto</h1>
    <h4 class="text-center" style="color: #1B5E20;">Información del Producto</h4>
    <hr />
    <div class="container" style="border: 1px solid #A5D6A7; padding: 20px; border-radius: 8px; background-color: #E8F5E9;">
        <form class="row" enctype="multipart/form-data" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Primera columna -->
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Nombre" class="control-label font-weight-bold" style="color: black;"></label>
                    <input asp-for="Nombre" class="form-control" style="border: 1px solid #81C784;" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Descripción" class="control-label font-weight-bold" style="color: black;"></label>
                    <input asp-for="Descripción" class="form-control" style="border: 1px solid #81C784;" />
                    <span asp-validation-for="Descripción" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="IdProveedor" class="control-label font-weight-bold" style="color: black;"></label>
                    <div class="d-flex align-items-center">
                        <select asp-for="IdProveedor" class="form-control" style="border: 1px solid #81C784;" asp-items="ViewBag.IdProveedor"></select>
                        <a asp-action="Index" asp-controller="Proveedor" class="btn btn-secondary btn-sm ms-2" style="background-color: #66BB6A; color: white; border: none;">
                            + Proveedor
                        </a>
                    </div>
                </div>
                <div class="form-group">
                    <label asp-for="PrecioCosto" class="control-label font-weight-bold" style="color: black;"></label>
                    <input asp-for="PrecioCosto" class="form-control" style="border: 1px solid #81C784;" />
                    <span asp-validation-for="PrecioCosto" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="PrecioVenta" class="control-label font-weight-bold" style="color: black;"></label>
                    <input asp-for="PrecioVenta" class="form-control" style="border: 1px solid #81C784;" />
                    <span asp-validation-for="PrecioVenta" class="text-danger"></span>
                </div>
            </div>

            <!-- Segunda columna -->
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="CódigoDeBarras" class="control-label font-weight-bold" style="color: black;"></label>
                    <input asp-for="CódigoDeBarras" class="form-control" style="border: 1px solid #81C784;" />
                    <span asp-validation-for="CódigoDeBarras" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="CantidadEnInventario" class="control-label font-weight-bold" style="color: black;"></label>
                    <input asp-for="CantidadEnInventario" class="form-control" style="border: 1px solid #81C784;" />
                    <span asp-validation-for="CantidadEnInventario" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="FechaDeIngreso" class="control-label font-weight-bold" style="color: black;"></label>
                    <input asp-for="FechaDeIngreso" class="form-control" style="border: 1px solid #81C784;" />
                    <span asp-validation-for="FechaDeIngreso" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="FechaDeCaducidad" class="control-label font-weight-bold" style="color: black;"></label>
                    <input asp-for="FechaDeCaducidad" class="form-control" style="border: 1px solid #81C784;" />
                    <span asp-validation-for="FechaDeCaducidad" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Laboratorio" class="control-label font-weight-bold" style="color: black;"></label>
                    <input asp-for="Laboratorio" class="form-control" style="border: 1px solid #81C784;" />
                    <span asp-validation-for="Laboratorio" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="control-label font-weight-bold" style="color: black;">Estado</label>
                    <div>
                        <div class="form-check form-check-inline">
                            <input type="radio" asp-for="Estado" class="form-check-input" value="Activo" id="estadoActivo" />
                            <label for="estadoActivo" class="form-check-label" style="color: black;">Activo</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input type="radio" asp-for="Estado" class="form-check-input" value="Inactivo" id="estadoInactivo" />
                            <label for="estadoInactivo" class="form-check-label" style="color: black;">Inactivo</label>
                        </div>
                    </div>
                    <span asp-validation-for="Estado" class="text-danger"></span>
                </div>

            </div>

            <!-- Botones centrados al final -->
            <div class="form-group mt-4 text-center col-md-12">
                <input type="submit" value="Crear" class="btn" style="background-color: #2E7D32; color: white; border: none; width: 120px;" />
                <a asp-action="Index" class="btn" style="background-color: #66BB6A; color: white; border: none; width: 120px;">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
