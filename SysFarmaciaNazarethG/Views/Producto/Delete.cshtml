@model SysFarmaciaNazarethG.Models.Producto

@{
    ViewData["Title"] = "Delete";
}

<h1 class="text-center" style="color: #2E7D32;">Eliminar Producto</h1>
<h3 class="text-center" style="color: #D32F2F;">¿Estás seguro de que quieres eliminar este producto?</h3>

<div class="container" style="border: 1px solid #FFCDD2; background-color: #FFEBEE; border-radius: 10px; padding: 20px;">
    <h4 class="text-center" style="color: #2E7D32;">Información del Producto</h4>
    <hr />
    <div class="row">
        <!-- Primera columna -->
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Nombre</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Nombre)</dd>

                <dt class="col-sm-4">Descripción</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Descripción)</dd>

                <dt class="col-sm-4">Precio Costo</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.PrecioCosto)</dd>

                <dt class="col-sm-4">Precio Venta</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.PrecioVenta)</dd>

                <dt class="col-sm-4">Código de Barras</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.CódigoDeBarras)</dd>
            </dl>
        </div>

        <!-- Segunda columna -->
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Cantidad en Inventario</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.CantidadEnInventario)</dd>

                <dt class="col-sm-4">Fecha de Ingreso</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.FechaDeIngreso)</dd>

                <dt class="col-sm-4">Fecha de Caducidad</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.FechaDeCaducidad)</dd>

                <dt class="col-sm-4">Laboratorio</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Laboratorio)</dd>

                <dt class="col-sm-4">Proveedor</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.IdProveedorNavigation.IdProveedor)</dd>
            </dl>
        </div>
    </div>

    <form asp-action="Delete" class="text-center mt-4">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" style="width: 150px;" /> |
        <a asp-action="Index" class="btn btn-secondary" style="width: 150px;">Regresar</a>
    </form>
</div>
