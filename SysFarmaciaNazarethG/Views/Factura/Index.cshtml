@model IEnumerable<SysFarmaciaNazarethG.Models.Factura>

@{
    ViewData["Title"] = "Index";
}
<head>
    <link rel="stylesheet" href="~/css/crud.css" />
</head>
 <h1>FACTURA</h1>

<p>
   

    <a asp-action="CrearFacturaSinIva" class="btn btn-primary" style="background-color: #007bff; border: none;">
        Crear Factura Sin IVA
    </a>

    <a asp-action="CrearFactura" class="btn btn-primary">Crear Factura</a>

</p> 
<table class="table">
    <thead>
        <tr>

            <th>
                @Html.DisplayNameFor(model => model.SubTotal)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Iva)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Total)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdClienteNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>

            <td>
                @Html.DisplayFor(modelItem => item.SubTotal)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Iva)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Total)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdClienteNavigation.IdCliente)
            </td>
            <td>
            
                    @* <a asp-action="Edit" asp-route-id="@item.IdFactura">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.IdFactura">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@item.IdFactura">Eliminar</a> *@
                    <!-- Botón para generar factura -->
                    @* <form asp-controller="Factura" asp-action="GenerarFacturaPDF" method="get">
                        <input type="hidden" name="idFactura" value="1" /> <!-- Reemplaza 1 con el ID de prueba -->
                        <button type="submit" class="btn btn-primary">
                            Generar Factura PDF
                        </button>
                    </form> *@

            </td>
        </tr>
}
    </tbody>
</table>
