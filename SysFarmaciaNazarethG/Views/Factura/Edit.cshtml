@model SysFarmaciaNazarethG.Models.Factura

@{
    ViewData["Title"] = "Editar Factura";
}

<h1 class="text-center" style="color:#2E7D32;">Editar Factura</h1>

<div class="container" style="border: 1px solid #A5D6A7; padding: 20px; border-radius: 8px; background-color: #E8F5E9;">
    <h4 class="text-center" style="color: #2E7D32;">Formulario de Edición de Factura</h4>
    <hr />
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="IdFactura" />

        <div class="row">
            <!-- Primera columna -->
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="FacturaNo" class="control-label"></label>
                    <input asp-for="FacturaNo" class="form-control" />
                    <span asp-validation-for="FacturaNo" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Fecha" class="control-label"></label>
                    <input asp-for="Fecha" class="form-control" />
                    <span asp-validation-for="Fecha" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="SubTotal" class="control-label"></label>
                    <input asp-for="SubTotal" class="form-control" />
                    <span asp-validation-for="SubTotal" class="text-danger"></span>
                </div>
            </div>

            <!-- Segunda columna -->
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Iva" class="control-label"></label>
                    <input asp-for="Iva" class="form-control" />
                    <span asp-validation-for="Iva" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Total" class="control-label"></label>
                    <input asp-for="Total" class="form-control" />
                    <span asp-validation-for="Total" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="IdVenta" class="control-label"></label>
                    <select asp-for="IdVenta" class="form-control" asp-items="ViewBag.IdVenta"></select>
                    <span asp-validation-for="IdVenta" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="IdCliente" class="control-label"></label>
                    <select asp-for="IdCliente" class="form-control" asp-items="ViewBag.IdCliente"></select>
                    <span asp-validation-for="IdCliente" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="text-center mt-4">
            <input type="submit" value="Guardar" class="btn btn-primary" style="width: 150px;" />
            <a asp-action="Index" class="btn btn-secondary" style="width: 150px;">Regresar</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
